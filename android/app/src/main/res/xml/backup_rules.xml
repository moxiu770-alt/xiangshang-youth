<?xml version="1.0" encoding="utf-8"?>
<!-- Health records, local drafts and login state must never be copied by the
     legacy Android backup mechanism. The remote account remains authoritative. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
