NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://xiangshang:xiangshang_dev@localhost:5432/xiangshang_youth
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5
ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
JOB_WORKER_MODE=embedded
JOB_WORKER_CONCURRENCY=4
JOB_WORKER_SHUTDOWN_TIMEOUT_MS=25000
FIELD_DEVICE_KEY_TTL_DAYS=90
FIELD_DEVICE_SIGNING_ENCRYPTION_KEY=local-development-field-device-signing-encryption-key
FIELD_DEVICE_SIGNED_REQUESTS_REQUIRED=false
FIELD_DEVICE_SIGNATURE_MAX_AGE_SECONDS=300
FIELD_DEVICE_OFFLINE_AFTER_SECONDS=90
FIELD_LIVENESS_RECONCILE_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_HEARTBEAT_INTERVAL_SECONDS=15
BACKUP_HEARTBEAT_MAX_AGE_SECONDS=60
# Optional remote archive for locally generated pg_dump files. Keep disabled in
# development unless a disposable S3-compatible bucket is configured.
BACKUP_ARCHIVE_ENABLED=false
BACKUP_ARCHIVE_PREFIX=xiangshang/database
