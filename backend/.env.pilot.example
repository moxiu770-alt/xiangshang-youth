# Server-only pilot environment. Copy to .env.pilot and replace every value.
# This environment is intentionally not accepted by the production preflight.
POSTGRES_DB=xiangshang_youth_pilot
POSTGRES_USER=xiangshang_pilot
POSTGRES_PASSWORD=replace_with_random_database_secret
PUBLIC_HOST=api.risingteen.com
METRICS_TOKEN=replace_with_random_metrics_token
FIELD_DEVICE_SIGNING_ENCRYPTION_KEY=replace_with_random_device_signing_key

# Pilot family registration is enabled so a real App can exercise the complete
# family onboarding flow. School/teacher accounts remain provisioned by school.
ALLOW_PUBLIC_REGISTRATION=true
