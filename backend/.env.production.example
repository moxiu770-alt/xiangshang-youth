# Copy to a secret-managed production environment. Never commit a filled file.
NODE_ENV=production
POSTGRES_DB=xiangshang_youth
POSTGRES_USER=replace_with_service_user
POSTGRES_PASSWORD=replace_with_strong_secret

# 移动端发布配置由 CI/密钥服务注入，不能写入 App 二进制或 Git。
# API_BASE_URL、灰度配置和 Sentry DSN 必须与同一正式 HTTPS 域名策略一致。
API_BASE_URL=https://api.example.edu.cn
USE_REMOTE_DATA_SOURCE=1
ROLLOUT_CONFIG_URL=https://api.example.edu.cn/v1/mobile-model-config
SENTRY_DSN=https://replace_with_public_key@replace_with_sentry_host/replace_with_project_id

# Public DNS must resolve to this host and ports 80/443 must reach Caddy.
PUBLIC_HOST=api.example.edu.cn
ACME_EMAIL=ops@example.edu.cn
CORS_ORIGIN=https://api.example.edu.cn
TRUST_PROXY=true

# 微信开放平台授权。三项必须同时配置，回调地址必须为已备案 HTTPS 地址。
WECHAT_APP_ID=replace_with_wechat_app_id
WECHAT_APP_SECRET=replace_with_wechat_app_secret
WECHAT_REDIRECT_URI=https://api.example.edu.cn/v1/auth/oauth/wechat/callback
OAUTH_STATE_TTL_SECONDS=300

# 服务商中台负责解析 receiverUserId 对应的 APNs/FCM/短信/微信目标。
# 每次请求携带 deliveryId 作为 Idempotency-Key，网关必须按该键去重。
NOTIFICATION_WEBHOOK_URL=https://notification-gateway.example.edu.cn/v1/deliveries
NOTIFICATION_WEBHOOK_AUTHORIZATION="Bearer replace_with_notification_gateway_token"
NOTIFICATION_WEBHOOK_TIMEOUT_MS=10000

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5
# 至少 32 个随机字符；用于 AES-256-GCM 加密 TOTP 密钥和恢复码校验，轮换前请先完成账户迁移。
MFA_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
# 独立于登录与审计密钥的验证码 pepper；不可写入客户端或数据库。
VERIFICATION_CODE_PEPPER=replace_with_at_least_32_random_characters
# 默认 true：管理员与校长首次登录必须自助注册 TOTP，其他角色仍可自愿启用。
REQUIRE_MFA_FOR_PRIVILEGED=true
# 独立于 MFA 的至少 32 位随机密钥；为审计事件哈希链签名。
AUDIT_LOG_SIGNING_KEY=replace_with_at_least_32_random_characters
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_HEALTH_CONSENT=true
HEALTH_DATA_RETENTION_DAYS=2555
# Raw visual evidence is kept for the shortest defensible period; replayable
# derived facts are retained longer for scoring/appeal traceability.
FIELD_EVIDENCE_VIDEO_RETENTION_DAYS=180
FIELD_EVIDENCE_DERIVED_RETENTION_DAYS=1095
FIELD_EVIDENCE_ORPHAN_RETENTION_HOURS=24
METRICS_TOKEN=replace_with_at_least_24_random_characters
# Host path to a root-readable file containing exactly the same METRICS_TOKEN.
METRICS_TOKEN_FILE=/secure/xiangshang/metrics_token

# Production evidence must use encrypted/versioned S3-compatible storage.
FILE_STORAGE_DRIVER=s3
S3_STORAGE_ENDPOINT=https://s3.example.edu.cn
S3_BUCKET=xiangshang-production-evidence
S3_ACCESS_KEY=replace_with_access_key
S3_SECRET_KEY=replace_with_secret_key
S3_REGION=auto
S3_ADDRESSING_STYLE=auto

# Keep an encrypted, access-separated database-backup archive in a different
# S3-compatible bucket from evidence. Retention/versioning/immutability are
# configured on the storage provider, not in this repository.
BACKUP_ENABLED=true
# 独立备份执行器启动后立即执行一次，之后按该周期持续归档。
BACKUP_INTERVAL_SECONDS=86400
BACKUP_HEARTBEAT_INTERVAL_SECONDS=15
BACKUP_HEARTBEAT_MAX_AGE_SECONDS=60
BACKUP_RETENTION_DAYS=7
BACKUP_ARCHIVE_ENABLED=true
BACKUP_ARCHIVE_PREFIX=xiangshang/database
BACKUP_S3_ENDPOINT=https://s3.example.edu.cn
BACKUP_S3_BUCKET=xiangshang-production-backups
BACKUP_S3_ACCESS_KEY=replace_with_backup_access_key
BACKUP_S3_SECRET_KEY=replace_with_backup_secret_key
BACKUP_S3_REGION=auto

DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
JOB_WORKER_ENABLED=true
JOB_WORKER_MODE=external
JOB_WORKER_INTERVAL_MS=1000
# 每个 Worker 进程一次安全领取并并发处理的任务数，建议按数据库/对象存储容量调整。
JOB_WORKER_CONCURRENCY=4
# 必须小于容器 30 秒停止宽限期；Worker 在窗口内排空已领取任务。
JOB_WORKER_SHUTDOWN_TIMEOUT_MS=25000
FIELD_DEVICE_KEY_TTL_DAYS=90
# 独立于数据库与 MFA 的至少 32 位随机密钥；加密服务端设备签名材料。
FIELD_DEVICE_SIGNING_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
# 设备密钥只用于本机 HMAC 派生，不会随请求传输；生产环境必须为 true。
FIELD_DEVICE_SIGNED_REQUESTS_REQUIRED=true
FIELD_DEVICE_SIGNATURE_MAX_AGE_SECONDS=300
FIELD_DEVICE_OFFLINE_AFTER_SECONDS=90
FIELD_LIVENESS_RECONCILE_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
