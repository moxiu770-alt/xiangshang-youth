<Window x:Class="Xiangshang.FieldClient.Windows.ConnectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接场地端"
        Width="640" Height="650" MinWidth="580" MinHeight="610"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F3F6FA" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#10233F"/>
    <SolidColorBrush x:Key="Muted" Color="#6F7F94"/>
    <SolidColorBrush x:Key="Blue" Color="#1769E0"/>
    <SolidColorBrush x:Key="Line" Color="#DFE7F0"/>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#F9FBFD"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#F9FBFD"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="22,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="BorderBrush" Value="{StaticResource Blue}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Blue}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C9DCF7"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#0F294C" CornerRadius="16" Padding="22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="13" Background="#2677E8"><TextBlock Text="连" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="连接 Windows 场地端" Foreground="White" FontSize="19" FontWeight="Bold"/><TextBlock Text="填写后台注册设备时显示的三项信息，测试成功后自动安全保存。" Foreground="#AFC2D9" FontSize="10" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="#EEF6FF" BorderBrush="#C9DCF7" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="从后台一次填入三项" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="在后台注册或轮换设备后，点击“一次复制三项接入信息”。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="9" LineHeight="15" Margin="0,4,0,0"/></StackPanel>
              <Button x:Name="PasteConnectionButton" Grid.Column="1" Content="从剪贴板粘贴" Width="126" Click="PasteConnectionButton_Click" Style="{StaticResource SecondaryButton}"/>
            </Grid>
          </Border>
          <Border x:Name="InfoPanel" Background="#EFF8F5" BorderBrush="#C6E7DB" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="#176B54" FontSize="10" LineHeight="17"/>
          </Border>
          <TextBlock Text="1  中央服务地址" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Bold"/>
          <TextBox x:Name="ApiBaseUrlTextBox" Margin="0,8,0,0" ToolTip="例如 http://192.168.5.11:8080/"/>
          <TextBlock Text="Windows 电脑与服务器不在同一台机器时，请填写服务器局域网 IP，不能填写 localhost。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" Margin="0,6,0,0"/>

          <TextBlock Text="2  设备 ID" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Bold" Margin="0,18,0,0"/>
          <TextBox x:Name="DeviceIdTextBox" Margin="0,8,0,0"/>
          <TextBlock Text="这是后台返回的设备 ID，不是设备名称或设备编码。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>

          <TextBlock Text="3  设备密钥" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Bold" Margin="0,18,0,0"/>
          <PasswordBox x:Name="DeviceKeyPasswordBox" Margin="0,8,0,0"/>
          <TextBlock x:Name="DeviceKeyHint" Text="密钥仅在后台注册或轮换时显示一次。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>

          <Border Background="#FFF8E7" BorderBrush="#F1D99E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0">
            <TextBlock Text="安全提示：测试通过后，密钥会写入 Windows Credential Manager，不会写进配置文件或日志。公开截图中出现过的密钥应先在后台轮换。" TextWrapping="Wrap" Foreground="#725513" FontSize="10" LineHeight="17"/>
          </Border>
          <Border x:Name="ErrorPanel" Background="#FFF0F0" BorderBrush="#F1C6C6" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B22C2C" FontSize="10" LineHeight="17"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="4">
      <TextBlock x:Name="ConnectionTestStatus" Text="保存前会验证服务器、设备身份和名单接口" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="88" Margin="0,0,8,0" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}"/><Button x:Name="SaveButton" Content="测试并保存" Width="126" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
