<Window x:Class="Xiangshang.FieldClient.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="向上少年 · 现场体测工作台"
        Width="1380" Height="860" MinWidth="1220" MinHeight="720"
        Background="#F2F5F9" FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#10233F"/>
    <SolidColorBrush x:Key="Muted" Color="#6F7F94"/>
    <SolidColorBrush x:Key="Blue" Color="#1769E0"/>
    <SolidColorBrush x:Key="BlueDark" Color="#0E54BA"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Green" Color="#118A68"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#E5F7F1"/>
    <SolidColorBrush x:Key="Amber" Color="#B87508"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#FFF5DD"/>
    <SolidColorBrush x:Key="Red" Color="#C93434"/>
    <SolidColorBrush x:Key="RedDark" Color="#A92121"/>
    <SolidColorBrush x:Key="Line" Color="#E1E8F0"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource BlueDark}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Blue}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9DCF7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource BlueSoft}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Red}"/><Setter Property="BorderBrush" Value="{StaticResource Red}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource RedDark}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Blue}"/><Setter TargetName="ItemBorder" Property="Background" Value="#F3F8FF"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#0F294C" Padding="26,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="12" Background="#2677E8"><TextBlock Text="向" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="向上少年" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="现场体测工作台" Foreground="#8FA8C8" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="当前测评任务" Foreground="#8FA8C8" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <ComboBox x:Name="TaskSelector" Width="390" Height="31" Margin="0,4,0,0" Padding="10,0" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="TaskSelector_SelectionChanged" Visibility="Collapsed"/>
          <TextBlock x:Name="TaskTitleText" Text="正在加载测评任务" Foreground="White" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0"/>
          <TextBlock x:Name="TaskMetaText" Text="请保持场地端连接" Foreground="#AFC2D9" FontSize="11" Margin="0,4,0,0" TextAlignment="Center"/>
          <TextBlock x:Name="TaskScopeText" Text="等待项目范围" Foreground="#C1D1E3" FontSize="10" Margin="0,3,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HeaderConnectionButton" Content="连接设置" Width="104" Height="42" Margin="0,0,10,0" Click="ConnectionSettingsButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
          <Button x:Name="EmergencyStopButton" Content="紧急停止" Width="112" Height="42" Margin="0,0,10,0" Click="EmergencyStopButton_Click" Style="{StaticResource DangerButton}"/>
          <Border Background="#17385F" BorderBrush="#2A4A70" BorderThickness="1" CornerRadius="12" Padding="13,9"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#F0B84A" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionStatus" Text="等待设备配置" Foreground="#DCE9F8" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <StackPanel><TextBlock Text="本站学生" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="Bold"/><TextBlock Text="已分配到本测试点的学生名单" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="QueueCoverageText" Text="正在核对任务名单与测试点分流" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="QueueRefreshText" Text="等待同步中央名单" Foreground="#7E8DA0" FontSize="10" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Border Background="{StaticResource BlueSoft}" CornerRadius="9" Padding="9,6" Margin="0,0,7,0"><TextBlock x:Name="QueueCountText" Text="0 人" Foreground="{StaticResource Blue}" FontSize="11" FontWeight="Bold"/></Border>
              <Button x:Name="RefreshQueueButton" Content="刷新" Height="31" Click="RefreshQueueButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
            <TextBox x:Name="QueueSearchTextBox" Height="36" Padding="11,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#F8FAFC" FontSize="11" TextChanged="QueueSearchTextBox_TextChanged" ToolTip="按学生姓名或班级搜索"/>
            <ComboBox x:Name="QueueStatusFilter" Grid.Column="2" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource Line}" FontSize="11" SelectionChanged="QueueStatusFilter_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="现场中" Tag="active"/><ComboBoxItem Content="时间超时" Tag="timing"/><ComboBoxItem Content="异常 / 补测" Tag="exception"/><ComboBoxItem Content="已完成" Tag="completed"/><ComboBoxItem Content="全部" Tag="all"/>
            </ComboBox>
          </Grid>
          <Grid Grid.Row="4">
            <ListBox x:Name="QueueList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource QueueItemStyle}" SelectionChanged="QueueList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource BlueSoft}" VerticalAlignment="Center"><TextBlock Text="{Binding QueueOrder}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding StudentName}" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding IdentityHint}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding NoteHint}" Visibility="{Binding NoteVisibility}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Amber}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="7" Padding="8,5" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="SemiBold"/></Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
              <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource BlueSoft}" HorizontalAlignment="Center"><TextBlock Text="名" Foreground="{StaticResource Blue}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="QueueEmptyTitle" Text="暂无候测学生" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="QueueEmptyDetail" Text="在后台生成队列后点击刷新" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="18" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <Button x:Name="QueueEmptyActionButton" Content="刷新任务和名单" Height="38" Margin="0,14,0,0" Click="QueueEmptyActionButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource Blue}" VerticalAlignment="Center"><TextBlock x:Name="SelectedStudentAvatar" Text="—" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center"><TextBlock Text="当前学生" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SelectedStudentName" Text="请从左侧选择" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="SelectedStudentClass" Text="候测名单将在这里显示" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><Border Background="{StaticResource AmberSoft}" CornerRadius="7" Padding="8,5" Margin="0,6,0,0" HorizontalAlignment="Left"><TextBlock x:Name="SelectedStudentIdentity" Text="选择后显示学籍身份信息" TextWrapping="Wrap" MaxWidth="540" Foreground="#7A5715" FontSize="10" FontWeight="SemiBold"/></Border><Border x:Name="SelectedStudentNotePanel" Visibility="Collapsed" Background="#FFF0E6" BorderBrush="#F0C3A4" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,5,0,0" HorizontalAlignment="Left"><TextBlock x:Name="SelectedStudentNote" Text="" TextWrapping="Wrap" MaxWidth="540" Foreground="#9B4C20" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel>
            <Border Grid.Column="2" Background="{StaticResource BlueSoft}" CornerRadius="9" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="SelectedStudentStatus" Text="未选择" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold"/></Border>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#132842" CornerRadius="18" Padding="22">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel MaxWidth="650"><TextBlock Text="现场采集" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="本次任务项目" Foreground="#8299B4" FontSize="9" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="CurrentTaskScopeText" Text="等待中央服务下发任务项目" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Foreground="#C8D8EA" FontSize="10" LineHeight="16" Margin="0,3,100,0"/></StackPanel>
              <Border HorizontalAlignment="Right" Background="#1C3859" CornerRadius="8" Padding="9,5"><TextBlock x:Name="CaptureModeBadge" Text="设备未接入" Foreground="#F0B84A" FontSize="9" FontWeight="Bold"/></Border>
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
              <Border Width="78" Height="78" CornerRadius="24" BorderBrush="#2C4A6E" BorderThickness="1" Background="#18314F"><TextBlock x:Name="CaptureStageIcon" Text="·" Foreground="#7EA6D4" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="CaptureStageTitle" Text="等待选择学生" Foreground="#DCE8F5" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
              <TextBlock x:Name="CaptureStageDetail" Text="学生姓名、班级和学籍身份会显示在上方" TextWrapping="Wrap" TextAlignment="Center" Foreground="#9BB0C8" FontSize="12" LineHeight="20" HorizontalAlignment="Center" Margin="0,7,0,0"/>
              <Border x:Name="CaptureLiveEventPanel" Visibility="Collapsed" Background="#1B385A" BorderBrush="#315579" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,14,0,0" MinWidth="410">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="#44D7A8" VerticalAlignment="Top" Margin="0,5,0,0"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock x:Name="CaptureLiveEventTitle" Text="等待设备首条反馈" Foreground="#ECF6FF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="CaptureLiveEventDetail" Text="采集事件会实时显示在这里" TextWrapping="Wrap" Foreground="#9CB6D1" FontSize="9" LineHeight="15" Margin="0,4,0,0"/></StackPanel>
                </Grid>
              </Border>
              <Border x:Name="ProtocolProgressPanel" Visibility="Collapsed" Background="#132B46" BorderBrush="#294A6D" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,10,0,0" MinWidth="410">
                <StackPanel>
                  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProtocolProgressTitle" Text="七项完整通道" Foreground="#ECF6FF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProtocolProgressCount" Grid.Column="1" Text="0/7" Foreground="#8EB8E7" FontSize="9" FontWeight="Bold"/></Grid>
                  <ItemsControl x:Name="ProtocolProgressList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="92" MinHeight="42" Margin="0,0,6,6" Padding="7,6" CornerRadius="8" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding SequenceLabel}" Foreground="{Binding Foreground}" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding Name}" Foreground="#DDEAF7" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Name}"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Foreground}" FontSize="8" Margin="0,2,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><Ellipse x:Name="StepCallDot" Width="10" Height="10" Fill="#39536F" HorizontalAlignment="Center"/><TextBlock x:Name="StepCallText" Text="1  叫号" Foreground="#7189A5" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="1"><Ellipse x:Name="StepCheckInDot" Width="10" Height="10" Fill="#39536F" HorizontalAlignment="Center"/><TextBlock x:Name="StepCheckInText" Text="2  确认" Foreground="#7189A5" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><Ellipse x:Name="StepCaptureDot" Width="10" Height="10" Fill="#39536F" HorizontalAlignment="Center"/><TextBlock x:Name="StepCaptureText" Text="3  采集" Foreground="#7189A5" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="3"><Ellipse x:Name="StepCompleteDot" Width="10" Height="10" Fill="#39536F" HorizontalAlignment="Center"/><TextBlock x:Name="StepCompleteText" Text="4  完成" Foreground="#7189A5" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="WorkflowActionTitle" Text="先选择一名学生" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="WorkflowActionDetail" Text="从左侧候测队列选择学生" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" Margin="0,5,16,0"/></StackPanel>
              <Border Grid.Column="1" Background="{StaticResource BlueSoft}" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="当前操作" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/></Border>
            </Grid>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button x:Name="CallNextButton" Content="叫号  F2" Height="56" MinWidth="142" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="CallNextButton_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="CheckInButton" Content="核验身份并签到  F3" Height="56" MinWidth="184" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="CheckInButton_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="StartCaptureButton" Content="开始正式采集  F4" Height="56" MinWidth="178" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="StartCaptureButton_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="CompleteCaptureButton" Content="核对并提交成绩  F8" Height="56" MinWidth="210" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="CompleteCaptureButton_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="RetestCaptureButton" Content="终止并安排补测" Height="48" MinWidth="150" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="RetestCaptureButton_Click" Style="{StaticResource SecondaryButton}"/>
              <Button x:Name="RecoverInterruptedButton" Content="处理中断并安排补测" Height="48" MinWidth="190" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="RecoverInterruptedButton_Click" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="AbsentButton" Content="标记缺席" Height="48" MinWidth="104" Visibility="Collapsed" IsEnabled="False" Click="AbsentButton_Click" Style="{StaticResource SecondaryButton}"/>
              <TextBlock x:Name="ActionEmptyText" Text="当前无需操作，请选择下一名学生" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Visibility="Visible"/>
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="现场状态" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="Bold"/><TextBlock Text="开测条件与本地同步" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          <Border x:Name="ReadinessPanel" Grid.Row="1" Background="{StaticResource AmberSoft}" BorderBrush="#F1D99E" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock x:Name="ReadinessTitle" Text="正在检查开测条件" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="Bold"/>
              <TextBlock x:Name="ReadinessDetail" Text="设备、标定与网络状态将在此显示" TextWrapping="Wrap" Foreground="#6C5A2D" FontSize="11" LineHeight="18" Margin="0,7,0,0"/>
              <ScrollViewer x:Name="ReadinessChecklistScroll" MaxHeight="190" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ItemsControl x:Name="ReadinessChecklist">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="9" LineHeight="15" Margin="0,2,0,0"/></StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="ReadinessMoreText" Text="" Foreground="{StaticResource Muted}" FontSize="9" Margin="19,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="ReadinessActionButton" Content="修复开测条件" Height="40" Margin="0,11,0,0" Visibility="Collapsed" Click="ReadinessActionButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
              <TextBlock x:Name="ReadinessActionHint" Text="" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="9" LineHeight="15" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Border Background="{StaticResource BlueSoft}" CornerRadius="11" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="下一位候测" Foreground="{StaticResource Blue}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="NextStudentText" Text="等待名单" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="Bold" Margin="0,5,8,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="SelectNextStudentButton" Grid.Column="1" Content="定位下一位  F6" Height="34" MinWidth="108" VerticalAlignment="Center" Click="SelectNextStudentButton_Click" Style="{StaticResource SecondaryButton}" FontSize="10" IsEnabled="False"/></Grid></Border>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WaitingCountText" Text="0" Foreground="{StaticResource Blue}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="待叫号" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ActiveCountText" Text="0" Foreground="{StaticResource Amber}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="处理中" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="CompletedCountText" Text="0" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="已提交" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="ExceptionCountText" Text="0" Foreground="{StaticResource Red}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="异常/补测" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Grid>
          </StackPanel>
          <Expander Grid.Row="3" Margin="0,14,0,0" Background="#F8FAFD" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11">
            <Expander.Header><StackPanel><TextBlock Text="设备、连接与同步" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="仅首次接入、设备更换或故障排查时使用" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/></StackPanel></Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <Button x:Name="ConnectionSettingsButton" Content="中央服务连接设置" Height="40" Margin="0,0,0,7" Click="ConnectionSettingsButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
              <Button x:Name="CaptureSettingsButton" Content="采集设备与厂商 DLL" Height="40" Margin="0,0,0,7" Click="CaptureSettingsButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
              <Button x:Name="SyncButton" Content="立即同步本地记录" Height="40" Click="SyncButton_Click" Style="{StaticResource SecondaryButton}" FontSize="11"/>
            </StackPanel>
          </Expander>
          <StackPanel Grid.Row="4" Margin="0,14,0,0"><Grid><TextBlock Text="操作提示" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="F2 叫号 · F3 签到 · F4 采集 · F6 下一位 · F8 提交" Foreground="#8494A8" FontSize="9" HorizontalAlignment="Right"/></Grid><Border Background="#F6F8FB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="OperationHint" Text="正在连接中央服务…" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="12" LineHeight="20"/></Border></StackPanel>
          <StackPanel Grid.Row="5" VerticalAlignment="Bottom"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Grid Margin="0,0,0,10"><TextBlock Text="本地离线保护" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="SyncStatusText" Text="正在统计" Foreground="{StaticResource Green}" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="现场操作会先保存在本机，网络恢复后可安全重试。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17"/></StackPanel>
        </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
