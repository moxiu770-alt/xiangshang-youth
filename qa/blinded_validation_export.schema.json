{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "向上少年独立人工盲审工作单",
  "description": "仅含不可逆样本码、内容摘要和标注空表。原始媒体只能保存在另行同意、权限隔离的验证环境，不得进入生产 App/API。",
  "type": "object",
  "required": ["exportVersion", "studyId", "datasetId", "frozenAt", "annotatorProtocolVersion", "doubleReviewFraction", "sourcePolicy", "blinding", "samples"],
  "properties": {
    "exportVersion": { "const": "UY-BLINDED-VALIDATION-1.0" },
    "studyId": { "type": "string", "minLength": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "frozenAt": { "type": "string", "format": "date-time" },
    "annotatorProtocolVersion": { "type": "string", "minLength": 1 },
    "doubleReviewFraction": { "type": "number", "minimum": 0.1, "maximum": 1 },
    "sourcePolicy": { "const": "separately-consented-secure-validation-storage" },
    "blinding": { "const": "model-output-and-identity-hidden" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sampleCode", "groupCode", "artifactSha256", "domain", "taskCode", "metadata", "annotation", "requiredReviewCount"],
        "properties": {
          "sampleCode": { "type": "string", "pattern": "^S-[a-f0-9]{20}$" },
          "groupCode": { "type": "string", "pattern": "^G-[a-f0-9]{20}$" },
          "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "domain": { "enum": ["body", "followAlong", "movement"] },
          "taskCode": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" },
          "annotation": { "type": "object" },
          "requiredReviewCount": { "enum": [1, 2] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
