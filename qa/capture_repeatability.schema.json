{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "向上少年同条件10次重复性验证集",
  "description": "只包含匿名主体ID和结构化结果，不得包含儿童姓名、照片、视频或原始骨架帧。引导式记录可验证家庭筛查重复性；只有宣称物理几何测量时才需要标定板、镜头内参与PnP证据。",
  "type": "object",
  "required": ["policyVersion", "postureGroups", "followAlongGroups"],
  "properties": {
    "policyVersion": { "const": "UY-REPEATABILITY-GATE-1.1" },
    "postureGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subjectId", "algorithmVersion", "deviceModel", "cameraPosition", "captureProtocolVersion", "calibrationMode", "cameraLensId", "resolution", "runs"],
        "properties": {
          "subjectId": { "type": "string", "minLength": 1 },
          "algorithmVersion": { "const": "UY-IMCA-CV-1.3" },
          "deviceModel": { "type": "string", "minLength": 1 },
          "cameraPosition": { "const": "rear" },
          "captureProtocolVersion": { "type": "string", "pattern": "^UY-CAPTURE-(GUIDED|MARKER-PNP)-" },
          "calibrationMode": { "enum": ["guided", "marker-pnp"] },
          "cameraLensId": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "pattern": "^[0-9]{3,5}x[0-9]{3,5}$" },
          "runs": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "required": ["runId", "setupId", "capturedAt", "captureProtocolVersion", "cameraFacing", "qualityChecks", "complete", "metrics"],
              "properties": {
                "runId": { "type": "string", "minLength": 1 },
                "setupId": { "type": "string", "minLength": 1, "description": "每次离开并重新进入标定区后的独立布置编号。" },
                "capturedAt": { "type": "string", "format": "date-time" },
                "captureProtocolVersion": { "type": "string", "pattern": "^UY-CAPTURE-(GUIDED|MARKER-PNP)-" },
                "cameraFacing": { "const": "rear-1x" },
                "qualityChecks": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "calibration": {
                  "type": "object",
                  "properties": {
                    "boardDetected": { "type": "boolean" },
                    "boardId": { "type": "string", "minLength": 1 },
                    "intrinsicsId": { "type": "string", "minLength": 1 },
                    "reprojectionErrorPx": { "type": "number", "minimum": 0, "maximum": 10 }
                  }
                },
                "complete": { "type": "boolean" },
                "metrics": { "type": "object", "additionalProperties": { "type": "number" } }
              }
            }
          }
        }
      }
    },
    "followAlongGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subjectId", "algorithmVersion", "deviceModel", "cameraPosition", "category", "expectedRepCount", "runs"],
        "properties": {
          "subjectId": { "type": "string", "minLength": 1 },
          "algorithmVersion": { "const": "UY-FOLLOW-CV-1.0" },
          "deviceModel": { "type": "string", "minLength": 1 },
          "cameraPosition": { "enum": ["front", "rear"] },
          "category": { "type": "string", "minLength": 1 },
          "expectedRepCount": { "type": "integer", "minimum": 0 },
          "runs": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "required": ["runId", "predictedRepCount"],
              "properties": {
                "runId": { "type": "string", "minLength": 1 },
                "predictedRepCount": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
