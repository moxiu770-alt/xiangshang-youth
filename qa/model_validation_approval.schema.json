{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "向上少年模型独立人工验证审批记录",
  "description": "只保存不可逆摘要与审批证据，禁止包含儿童身份、原始视频、照片或骨架序列。",
  "type": "object",
  "required": ["approvalVersion", "approvalId", "status", "datasetId", "corpusSha256", "evaluationReportSha256", "repeatabilityCorpusSha256", "repeatabilityReportSha256", "modelRegistryVersion", "modelVersions", "postureDomainValidation", "validationProtocol", "evaluatedAt", "approvers"],
  "properties": {
    "approvalVersion": { "const": "UY-MODEL-APPROVAL-1.1" },
    "approvalId": { "type": "string", "minLength": 8 },
    "status": { "const": "human-validated" },
    "datasetId": { "type": "string", "minLength": 1 },
    "corpusSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "evaluationReportSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "repeatabilityCorpusSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "repeatabilityReportSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "modelRegistryVersion": { "type": "string", "minLength": 1 },
    "modelVersions": {
      "type": "object",
      "required": ["movement", "posture", "bmi", "height", "followAlong", "growth"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "postureDomainValidation": {
      "type": "object",
      "required": ["spinal_alignment", "shoulder_pelvis", "head_upper_posture", "trunk_rotation", "dynamic_knee", "gait", "seated_posture", "foot_arch"],
      "properties": {
        "spinal_alignment": { "$ref": "#/$defs/domainApproval" },
        "shoulder_pelvis": { "$ref": "#/$defs/domainApproval" },
        "head_upper_posture": { "$ref": "#/$defs/domainApproval" },
        "trunk_rotation": { "$ref": "#/$defs/domainApproval" },
        "dynamic_knee": { "$ref": "#/$defs/domainApproval" },
        "gait": { "$ref": "#/$defs/domainApproval" },
        "seated_posture": { "$ref": "#/$defs/domainApproval" },
        "foot_arch": { "$ref": "#/$defs/domainApproval" }
      },
      "additionalProperties": false
    },
    "validationProtocol": {
      "type": "object",
      "required": ["doubleScreenedFraction", "cohensKappa", "ageThresholdCohorts"],
      "properties": {
        "doubleScreenedFraction": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "cohensKappa": { "type": "number", "minimum": 0.8, "maximum": 1 },
        "ageThresholdCohorts": {
          "type": "array",
          "minItems": 13,
          "items": {
            "type": "object",
            "required": ["ageYears", "sampleCount"],
            "properties": {
              "ageYears": { "type": "integer", "minimum": 6, "maximum": 18 },
              "sampleCount": { "type": "integer", "minimum": 500 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "approvers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["reviewerId", "role", "approvedAt"],
        "properties": {
          "reviewerId": { "type": "string", "minLength": 3 },
          "role": { "enum": ["data-quality", "algorithm-owner", "clinical-or-safety-reviewer", "release-manager"] },
          "approvedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "domainApproval": {
      "type": "object",
      "required": ["status", "datasetId", "sampleCount", "evaluationReportSha256", "evaluatedAt"],
      "properties": {
        "status": { "const": "human-validated" },
        "datasetId": { "type": "string", "minLength": 1 },
        "sampleCount": { "type": "integer", "minimum": 500 },
        "evaluationReportSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "evaluatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
